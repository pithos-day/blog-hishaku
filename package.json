{
  "name": "blog-hishaku",
  "version": "0.1.0",
  "description": "最小構成の Astro ブログテンプレート",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "postinstall": "node scripts/sync-katex.mjs",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint-staged": "lint-staged",
    "generate:lqips": "tsx scripts/generateLqips.ts",
    "generate:similarities": "tsx scripts/generateSimilarities.ts",
    "test": "node --experimental-strip-types --import ./test/register.mjs --test test/*.test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,astro,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "keywords": [
    "astro",
    "blog",
    "template"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "astro-icon": "^1.2.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "iconify-icon": "^3.0.3",
    "katex": "^0.19.0",
    "lucide": "^1.55.0",
    "metascraper": "^5.58.1",
    "metascraper-description": "^5.56.2",
    "metascraper-image": "^5.56.2",
    "metascraper-logo": "^5.56.2",
    "metascraper-logo-favicon": "^5.58.1",
    "metascraper-title": "^5.56.2",
    "metascraper-url": "^5.56.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sanitize-html": "^2.18.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@huggingface/transformers": "^4.3.1",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/lucide": "^1.2.142",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/unist": "^3.0.3",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
