---
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')}>
  <div class="py-16 text-center">
    <p class="text-6xl font-semibold">404</p>
    <p class="mt-4">{t('notFound.message')}</p>
    <a href="/" class="mt-6 inline-block text-accent underline">{t('notFound.backHome')}</a>
  </div>
</BaseLayout>
