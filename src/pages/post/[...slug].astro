---
import { render } from 'astro:content';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, normalizeCategories } from '@/lib/categories';
import { siteConfig } from '@/lib/config';
import { formatDate } from '@/lib/date';
import { getPostDescription, getPostSlug, getPublishedPosts, type PostEntry } from '@/lib/posts';
import { formatCharacterCount, formatReadingTime, getTextStats } from '@/lib/reading';
import { buildTagHref } from '@/lib/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post) },
    props: { post, prev: posts[index + 1] ?? null, next: posts[index - 1] ?? null },
  }));
}

interface Props {
  post: PostEntry;
  prev: PostEntry | null;
  next: PostEntry | null;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const timezone = siteConfig.site.timezone;
const description = getPostDescription(post);

// 目次 (左サイドバー) 用に h2/h3 の見出しを抽出 (2見出しから表示)
const tocHeadings = siteConfig.content.enableToc
  ? headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
  : [];

const categoryChains = normalizeCategories(post.data.categories);
const stats = getTextStats(post);
---

<BaseLayout
  title={post.data.title}
  description={description}
  ogImage={post.data.cover}
  type="article"
  math={post.data.math !== false}
  tocHeadings={tocHeadings}
>
  <article data-pagefind-body>
    <header>
      <h1 data-pagefind-meta="title" class="entry-title-bar post-title">{post.data.title}</h1>
    </header>

    <div class="post-body prose prose-zinc max-w-none dark:prose-invert">
      {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
      <p class="entry-posted">
        <span class="meta-item">
          <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date, timezone)}
          </time>
        </span>
        {
          post.data.updated && (
            <span class="meta-item">
              <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              {t('post.updatedAt', { date: formatDate(post.data.updated, timezone) })}
            </span>
          )
        }
        <span class="meta-item">
          <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
          {formatCharacterCount(stats.characters)}
        </span>
        <span class="meta-item">
          <i class="fa-solid fa-clock" aria-hidden="true"></i>
          {formatReadingTime(stats.minutes)}
        </span>
        {
          categoryChains.length > 0 && (
            <span>
              {categoryChains.map((chain, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">|</span>}
                  <a href={buildCategoryHref(chain)}>{chain.join(' › ')}</a>
                </>
              ))}
            </span>
          )
        }
        {
          post.data.tags && post.data.tags.length > 0 && (
            <span>
              {post.data.tags.map((tag, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">|</span>}
                  <a href={buildTagHref(tag)}>{tag}</a>
                </>
              ))}
            </span>
          )
        }
        {post.data.sticky && <span class="entry-badge entry-badge-pin">PIN</span>}
        {!import.meta.env.PROD && post.data.draft && (
          <span class="entry-badge entry-badge-draft">DRAFT</span>
        )}
      </p>
      {!import.meta.env.PROD && post.data.draft && (
        <p class="mb-3 text-sm text-accent">{t('post.draftNotice')}</p>
      )}
      <Content />
      <hr class="post-nav-divider" />
      <nav class="post-nav" aria-label={t('post.contextNavAria')}>
        {
          prev ? (
            <a href={`/post/${getPostSlug(prev)}`} class="post-nav-link">
              « {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`/post/${getPostSlug(next)}`} class="post-nav-link post-nav-next">
              {next.data.title} »
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </article>

  <script>
    import { t } from '@/i18n';
    import { siteConfig } from '@/lib/config';

    const flags = siteConfig.content;

    // 外部リンクを新規タブで開く
    if (flags.addBlankTarget) {
      for (const anchor of document.querySelectorAll<HTMLAnchorElement>('.prose a[href]')) {
        const href = anchor.getAttribute('href') ?? '';
        if (/^(https?:)?\/\//.test(href)) {
          anchor.target = '_blank';
          anchor.rel = 'noopener noreferrer';
        }
      }
    }

    // 見出しにレベル表示用の data-level を付与
    if (flags.addHeadingLevel) {
      for (const heading of document.querySelectorAll('h1, h2, h3, h4, h5, h6')) {
        heading.setAttribute('data-level', `H${heading.tagName[1]}`);
      }
    }

    // 見出しアンカーのスムーススクロール
    if (flags.smoothScroll) {
      for (const anchor of document.querySelectorAll<HTMLAnchorElement>(
        'a.anchor-link[href^="#"], .post-toc a[href^="#"]',
      )) {
        anchor.addEventListener('click', (event) => {
          event.preventDefault();
          const target = document.getElementById(decodeURIComponent(anchor.hash.slice(1)));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', anchor.hash);
          }
        });
      }
    }

    // ;;; タブの切替
    for (const group of document.querySelectorAll('.tab-group')) {
      const headers = group.querySelectorAll<HTMLButtonElement>('.tab-header');
      const panels = group.querySelectorAll<HTMLElement>('.tab-panel');
      headers.forEach((header, index) => {
        header.addEventListener('click', () => {
          headers.forEach((item, i) => {
            const active = i === index;
            item.classList.toggle('active', active);
            item.setAttribute('aria-selected', String(active));
          });
          panels.forEach((panel, i) => panel.classList.toggle('active', i === index));
        });
      });
    }

    // スポイザーのクリックで表示切替
    for (const spoiler of document.querySelectorAll('.spoiler')) {
      spoiler.addEventListener('click', () => spoiler.classList.toggle('revealed'));
    }

    // コードブロック強化: 折りたたみ・コピー・全画面
    if (flags.enhanceCodeBlock) {
      for (const frame of document.querySelectorAll<HTMLElement>('.code-frame')) {
        const code = frame.querySelector('code');
        if (!code) continue;

        const setFolded = (folded: boolean) => {
          frame.classList.toggle('code-frame--folded', folded);
          const toggle = frame.querySelector<HTMLButtonElement>('.frame-btn-fold');
          if (toggle) {
            const label = folded ? t('code.expand') : t('code.collapse');
            toggle.setAttribute('aria-label', label);
            toggle.title = label;
            toggle.setAttribute('aria-expanded', String(!folded));
          }
        };

        frame.querySelector('.frame-btn-fold')?.addEventListener('click', () => {
          setFolded(!frame.classList.contains('code-frame--folded'));
        });
        frame.querySelector('.fold-overlay')?.addEventListener('click', () => setFolded(false));

        const copyButton = frame.querySelector<HTMLButtonElement>('.frame-btn-copy');
        if (copyButton) {
          let resetTimer: ReturnType<typeof setTimeout> | undefined;
          copyButton.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code.textContent ?? '');
            } catch {
              return; // クリップボードが使えない環境
            }
            copyButton.classList.add('is-copied');
            if (resetTimer) clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
              copyButton.classList.remove('is-copied');
            }, 2000);
          });
        }

        frame.querySelector('.frame-btn-full')?.addEventListener('click', () => {
          if (document.fullscreenElement) {
            void document.exitFullscreen();
          } else {
            void frame.requestFullscreen();
          }
        });
      }
    }
  </script>
</BaseLayout>
