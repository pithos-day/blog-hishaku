---
import { render } from 'astro:content';
import PostMeta from '@/components/PostMeta.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, normalizeCategories } from '@/lib/categories';
import { siteConfig } from '@/lib/config';
import { getPostDescription, getPostSlug, getPublishedPosts, type PostEntry } from '@/lib/posts';
import { getSimilarPosts } from '@/lib/similar-posts';
import { getPostSummary } from '@/lib/summary';
import { buildTagHref } from '@/lib/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post) },
    props: { post, prev: posts[index + 1] ?? null, next: posts[index - 1] ?? null },
  }));
}

interface Props {
  post: PostEntry;
  prev: PostEntry | null;
  next: PostEntry | null;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const description = getPostDescription(post);
const slug = getPostSlug(post);
const summary = getPostSummary(slug);
const similarPosts = getSimilarPosts(slug);

// 目次 (左サイドバー) 用に h2/h3 の見出しを抽出 (2見出しから表示)
const tocHeadings = siteConfig.content.enableToc
  ? headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
  : [];

const categoryChains = normalizeCategories(post.data.categories);

// meta keywords / JSON-LD 用: frontmatter keywords + タグ + カテゴリ名を重複除去
const seoKeywords = [
  ...new Set([...(post.data.keywords ?? []), ...(post.data.tags ?? []), ...categoryChains.flat()]),
];

// schema.org 用: サイトタイムゾーン基準の yyyy-MM-dd
const seoDate = (date: Date): string =>
  new Intl.DateTimeFormat('en-CA', {
    timeZone: siteConfig.site.timezone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);

// OGP 画像と同一のフォールバック (cover → defaultOgImage → avatar)
const jsonLdImageSrc = post.data.cover ?? siteConfig.site.defaultOgImage ?? siteConfig.site.avatar;
const jsonLdImage = jsonLdImageSrc ? new URL(jsonLdImageSrc, siteConfig.site.url).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  keywords: [...new Set([...seoKeywords, ...siteConfig.site.keywords])],
  author: {
    '@type': 'Person',
    name: siteConfig.site.author ?? siteConfig.site.name ?? siteConfig.site.title,
    url: siteConfig.site.url,
  },
  datePublished: seoDate(post.data.date),
  ...(post.data.updated && { dateModified: seoDate(post.data.updated) }),
  ...(jsonLdImage && { image: jsonLdImage }),
  mainEntityOfPage: new URL(Astro.url.pathname, siteConfig.site.url).href,
};

// カテゴリがある記事はパンくず JSON-LD も出力 (最終項目は item なし)
const breadcrumbChain = categoryChains[0] ?? [];
const breadcrumbJsonLd =
  breadcrumbChain.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: t('breadcrumb.home'),
            item: new URL('/', siteConfig.site.url).href,
          },
          ...breadcrumbChain.map((name, index) => ({
            '@type': 'ListItem',
            position: index + 2,
            name,
            item: new URL(
              buildCategoryHref(breadcrumbChain.slice(0, index + 1)),
              siteConfig.site.url,
            ).href,
          })),
          { '@type': 'ListItem', position: breadcrumbChain.length + 2, name: post.data.title },
        ],
      }
    : undefined;

/** `<` をエスケープして script タグ内の JSON が早期終了するのを防ぐ */
const toJsonLdHtml = (value: unknown): string => JSON.stringify(value).replace(/</g, '\\u003c');
---

<BaseLayout
  title={post.data.title}
  description={description}
  keywords={seoKeywords}
  ogImage={post.data.cover}
  type="article"
  math={post.data.math !== false}
  tocHeadings={tocHeadings}
  similarPosts={similarPosts}
>
  <script is:inline slot="head" type="application/ld+json" set:html={toJsonLdHtml(jsonLd)} />
  {breadcrumbJsonLd && (
    <script is:inline slot="head" type="application/ld+json" set:html={toJsonLdHtml(breadcrumbJsonLd)} />
  )}
  <article data-pagefind-body>
    <header>
      <h1 data-pagefind-meta="title" class="entry-title-bar post-title">{post.data.title}</h1>
    </header>

    {summary && (
      <aside class="post-summary not-prose" aria-label="記事要約">
        <p>{summary}</p>
      </aside>
    )}

    <div class="post-body prose prose-zinc max-w-none dark:prose-invert">
      {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
      <p class="entry-posted">
        <PostMeta post={post} />
        {
          categoryChains.length > 0 && (
            <span>
              {categoryChains.map((chain, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">|</span>}
                  <a href={buildCategoryHref(chain)}>{chain.join(' › ')}</a>
                </>
              ))}
            </span>
          )
        }
        {
          post.data.tags && post.data.tags.length > 0 && (
            <span>
              {post.data.tags.map((tag, index) => (
                <>
                  {index > 0 && <span aria-hidden="true">|</span>}
                  <a href={buildTagHref(tag)}>{tag}</a>
                </>
              ))}
            </span>
          )
        }
        {post.data.sticky && <span class="entry-badge entry-badge-pin">{t('post.badgePin')}</span>}
        {!import.meta.env.PROD && post.data.draft && (
          <span class="entry-badge entry-badge-draft">{t('post.badgeDraft')}</span>
        )}
      </p>
      {!import.meta.env.PROD && post.data.draft && (
        <p class="mb-3 text-sm text-accent">{t('post.draftNotice')}</p>
      )}
      <Content />
      <hr class="post-nav-divider" />
      <nav class="post-nav" aria-label={t('post.contextNavAria')}>
        {
          prev ? (
            <a href={`/post/${getPostSlug(prev)}/`} class="post-nav-link">
              « {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={`/post/${getPostSlug(next)}/`} class="post-nav-link post-nav-next">
              {next.data.title} »
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </div>
  </article>

  <script>
    import { initPostEnhancements } from '@/scripts/post';

    initPostEnhancements();
  </script>
</BaseLayout>
