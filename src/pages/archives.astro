---
import PostRow from '@/components/PostRow.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getArchives } from '@/lib/archives';

const years = await getArchives();
const total = years.reduce(
  (sum, year) => sum + year.months.reduce((monthSum, month) => monthSum + month.posts.length, 0),
  0,
);
---

<BaseLayout title={t('archives.title')}>
  <header class="page-header">
    <h1>{t('archives.title')}</h1>
    <p>{t('common.postCount', { count: total })}</p>
  </header>
  <div class="mt-6 space-y-8">
    {
      years.map((year) => (
        <section id={`year-${year.year}`}>
          <h2 class="text-xl font-bold">
            <a href={`#year-${year.year}`} class="hover:text-accent">{t('archives.year', { year: year.year })}</a>
          </h2>
          <div class="mt-3 space-y-5">
            {year.months.map((month) => (
              <section id={`month-${month.year}-${String(month.month).padStart(2, '0')}`}>
                <h3 class="text-sm font-semibold text-fg-muted">
                  <a
                    href={`#month-${month.year}-${String(month.month).padStart(2, '0')}`}
                    class="hover:text-accent"
                  >
                    {t('archives.month', { year: month.year, month: month.month })}
                  </a>
                  <span class="ml-1">({month.posts.length})</span>
                </h3>
                <div class="mt-1">
                  {month.posts.map((post) => (
                    <PostRow post={post} />
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))
    }
    {years.length === 0 && <p class="text-fg-muted">{t('common.noPosts')}</p>}
  </div>
</BaseLayout>
