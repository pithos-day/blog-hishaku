---
import type { Page } from 'astro';
import PostMeta from '@/components/PostMeta.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, normalizeCategories } from '@/lib/categories';
import { getLqipProps } from '@/lib/lqip';
import { buildPostPage, POSTS_PAGE_SIZE } from '@/lib/pagination';
import { getPostDescription, getPostSlug, getPublishedPosts, type PostEntry } from '@/lib/posts';
import { buildTagHref } from '@/lib/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PAGE_SIZE));

  // 1 ページ目は /・/posts/・/posts/1/ の 3 URL、2 ページ目以降は /posts/{N}/
  const paths = [
    { params: { page: undefined }, props: { page: buildPostPage(posts, 1) } },
    { params: { page: 'posts' }, props: { page: buildPostPage(posts, 1) } },
    { params: { page: 'posts/1' }, props: { page: buildPostPage(posts, 1) } },
  ];
  for (let current = 2; current <= lastPage; current++) {
    paths.push({
      params: { page: `posts/${current}` },
      props: { page: buildPostPage(posts, current) },
    });
  }
  return paths;
}

interface Props {
  page: Page<PostEntry>;
}

const { page } = Astro.props;
const posts = page.data;
---

<BaseLayout canonicalPath={page.url.current}>
  <section aria-label={t('index.listAria')}>
    {
      posts.length === 0 ? (
        <p class="text-fg-muted">{t('index.empty')}</p>
      ) : (
        <ul>
          {posts.map((post) => (
            <li class="entry">
              <h2 class="entry-title-bar">
                <a href={`/post/${getPostSlug(post)}/`}>{post.data.title}</a>
              </h2>
              <div class="entry-body">
                <p class="entry-submeta">
                  <PostMeta post={post} />
                </p>
                {post.data.cover && (
                  <a href={`/post/${getPostSlug(post)}/`} tabindex={-1} aria-hidden="true">
                    <img
                      src={post.data.cover}
                      alt=""
                      class="entry-cover"
                      loading="lazy"
                      {...getLqipProps(post.data.cover)}
                    />
                  </a>
                )}
                {post.data.subtitle && <p class="entry-subtitle">{post.data.subtitle}</p>}
                <p class="entry-desc">{getPostDescription(post)}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="entry-tags">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a href={buildTagHref(tag)}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                )}
                <hr class="entry-divider" />
                <p class="entry-meta">
                  {post.data.sticky && <span class="entry-badge entry-badge-pin">{t('post.badgePin')}</span>}
                  {!import.meta.env.PROD && post.data.draft && (
                    <span class="entry-badge entry-badge-draft">{t('post.badgeDraft')}</span>
                  )}
                  {normalizeCategories(post.data.categories).map((chain) => (
                    <a href={buildCategoryHref(chain)}>{chain.join(' › ')}</a>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label={t('index.paginationAria')}>
          {page.url.prev ? (
            <a href={page.url.prev} class="page-link">
              {t('index.prevPage')}
            </a>
          ) : (
            <span class="page-link page-link-disabled">{t('index.prevPage')}</span>
          )}
          <span class="page-status">
            {page.currentPage} / {page.lastPage}
          </span>
          {page.url.next ? (
            <a href={page.url.next} class="page-link">
              {t('index.nextPage')}
            </a>
          ) : (
            <span class="page-link page-link-disabled">{t('index.nextPage')}</span>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
