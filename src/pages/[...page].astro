---
import type { Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, normalizeCategories } from '@/lib/categories';
import { siteConfig } from '@/lib/config';
import { formatDate } from '@/lib/date';
import { getPostDescription, getPostSlug, getPublishedPosts, type PostEntry } from '@/lib/posts';
import { formatCharacterCount, formatReadingTime, getTextStats } from '@/lib/reading';
import { buildTagHref } from '@/lib/tags';

export async function getStaticPaths({
  paginate,
}: {
  paginate: (data: PostEntry[], opts: { pageSize: number }) => unknown[];
}) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 10 });
}

interface Props {
  page: Page<PostEntry>;
}

const { page } = Astro.props;
const posts = page.data;
const timezone = siteConfig.site.timezone;
---

<BaseLayout>
  <section aria-label="記事一覧">
    {
      posts.length === 0 ? (
        <p class="text-fg-muted">まだ記事がありません。src/content/blog/ に記事を追加してください。</p>
      ) : (
        <ul>
          {posts.map((post) => {
            const stats = getTextStats(post);
            return (
              <li class="entry">
                <h2 class="entry-title-bar">
                  <a href={`/post/${getPostSlug(post)}`}>{post.data.title}</a>
                </h2>
                <div class="entry-body">
                  <p class="entry-submeta">
                    <span class="meta-item">
                      <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date, timezone)}
                      </time>
                    </span>
                    {post.data.updated && (
                      <span class="meta-item">
                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                        更新 {formatDate(post.data.updated, timezone)}
                      </span>
                    )}
                    <span class="meta-item">
                      <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
                      {formatCharacterCount(stats.characters)}
                    </span>
                    <span class="meta-item">
                      <i class="fa-solid fa-clock" aria-hidden="true"></i>
                      {formatReadingTime(stats.minutes)}
                    </span>
                  </p>
                  {post.data.cover && (
                    <a href={`/post/${getPostSlug(post)}`} tabindex={-1} aria-hidden="true">
                      <img src={post.data.cover} alt="" class="entry-cover" loading="lazy" />
                    </a>
                  )}
                  {post.data.subtitle && <p class="entry-subtitle">{post.data.subtitle}</p>}
                  <p class="entry-desc">{getPostDescription(post)}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="entry-tags">
                      {post.data.tags.map((tag) => (
                        <li>
                          <a href={buildTagHref(tag)}>{tag}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                  <hr class="entry-divider" />
                  <p class="entry-meta">
                    {post.data.sticky && <span class="entry-badge entry-badge-pin">PIN</span>}
                    {!import.meta.env.PROD && post.data.draft && (
                      <span class="entry-badge entry-badge-draft">DRAFT</span>
                    )}
                    {normalizeCategories(post.data.categories).map((chain) => (
                      <a href={buildCategoryHref(chain)}>{chain.join(' › ')}</a>
                    ))}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }

    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label="ページネーション">
          {page.url.prev ? (
            <a href={page.url.prev} class="page-link">
              ← 前のページ
            </a>
          ) : (
            <span class="page-link page-link-disabled">← 前のページ</span>
          )}
          <span class="page-status">
            {page.currentPage} / {page.lastPage}
          </span>
          {page.url.next ? (
            <a href={page.url.next} class="page-link">
              次のページ →
            </a>
          ) : (
            <span class="page-link page-link-disabled">次のページ →</span>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
