---
import type { Page } from 'astro';
import PostMeta from '@/components/PostMeta.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, normalizeCategories } from '@/lib/categories';
import { getLqipGradient } from '@/lib/lqip';
import { buildPostPage, calcLastPage } from '@/lib/pagination';
import {
  getPostDescription,
  getPostSlug,
  getPublishedPosts,
  type PostEntry,
  postPath,
  shouldShowDraft,
} from '@/lib/posts';
import { buildTagHref } from '@/lib/tags';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const lastPage = calcLastPage(posts.length);

  // 1 ページ目は /・/posts/・/posts/1/ の 3 URL、2 ページ目以降は /posts/{N}/
  const paths = [
    { params: { page: undefined }, props: { page: buildPostPage(posts, 1) } },
    { params: { page: 'posts' }, props: { page: buildPostPage(posts, 1) } },
    { params: { page: 'posts/1' }, props: { page: buildPostPage(posts, 1) } },
  ];
  for (let current = 2; current <= lastPage; current++) {
    paths.push({
      params: { page: `posts/${current}` },
      props: { page: buildPostPage(posts, current) },
    });
  }
  return paths;
}

interface Props {
  page: Page<PostEntry>;
}

const { page } = Astro.props;
const posts = page.data;

/**
 * カバー画像のインラインレイアウト指定。
 *
 * 本来のレイアウトは CSS (.entry-cover) が担うが、外部スタイルシートが届くまでの
 * 未整形状態では img の幅・高さ属性 (presentational hint) が 1600×700px の
 * 固定サイズとして効いてしまい、「引き伸ばされた巨大なカバー」が一瞬出る
 * 経路になっていた (属性を付けた 5470b52 以降に発生)。
 *
 * インラインスタイルは presentational hint より優先度が高く、HTML をパースした
 * 瞬間から適用されるため、CSS が 0 バイトでも最初の描画から 16 : 7 のサイズ
 * 予約が保たれる。CSS 側 (.entry-cover) と必ず同じ値に揃えること。
 */
const COVER_INLINE_STYLE = 'width:100%;height:auto;aspect-ratio:16/7;object-fit:cover';

/** 上記のレイアウト指定と LQIP グラデーションを1つの style 属性に結合する */
function coverStyle(cover: string): string {
  const gradient = getLqipGradient(cover);
  return gradient ? `${COVER_INLINE_STYLE};background-image:${gradient}` : COVER_INLINE_STYLE;
}
---

<BaseLayout canonicalPath={page.url.current}>
  <section aria-label={t('index.listAria')}>
    {
      posts.length === 0 ? (
        <p class="text-fg-muted">{t('index.empty')}</p>
      ) : (
        <ul>
          {posts.map((post) => (
            <li class="entry">
              <h2 class="entry-title-bar">
                <a href={postPath(getPostSlug(post))}>{post.data.title}</a>
              </h2>
              <div class="entry-body">
                <p class="entry-submeta">
                  <PostMeta post={post} />
                </p>
                {post.data.cover && (
                  <a href={postPath(getPostSlug(post))} tabindex={-1} aria-hidden="true">
                    <img
                      src={post.data.cover}
                      alt=""
                      class="entry-cover"
                      loading="lazy"
                      style={coverStyle(post.data.cover)}
                    />
                  </a>
                )}
                {post.data.subtitle && <p class="entry-subtitle">{post.data.subtitle}</p>}
                <p class="entry-desc">{getPostDescription(post)}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <ul class="entry-tags">
                    {post.data.tags.map((tag) => (
                      <li>
                        <a href={buildTagHref(tag)}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                )}
                <hr class="entry-divider" />
                <p class="entry-meta">
                  {post.data.sticky && <span class="entry-badge entry-badge-pin">{t('post.badgePin')}</span>}
                  {shouldShowDraft(post) && (
                    <span class="entry-badge entry-badge-draft">{t('post.badgeDraft')}</span>
                  )}
                  {normalizeCategories(post.data.categories).map((chain) => (
                    <a href={buildCategoryHref(chain)}>{chain.join(' › ')}</a>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label={t('index.paginationAria')}>
          {page.url.prev && (
            <a href={page.url.prev} class="page-link pagination-prev">
              {t('index.prevPage')}
            </a>
          )}
          <span class="page-status">
            {page.currentPage} / {page.lastPage}
          </span>
          {page.url.next && (
            <a href={page.url.next} class="page-link pagination-next">
              {t('index.nextPage')}
            </a>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>
