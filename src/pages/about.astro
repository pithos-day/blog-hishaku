---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const about = await getEntry('pages', 'about');
if (!about) {
  throw new Error('src/content/pages/about.md が見つかりません');
}

const { Content, headings } = await render(about);
// 記事ページと同じく h2/h3 を左サイドバーの目次パネルに渡す
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={about.data.title}
  description={about.data.description}
  type="article"
  tocHeadings={tocHeadings}
>
  <article data-pagefind-body>
    <header>
      <h1 class="entry-title-bar post-title">{about.data.title}</h1>
    </header>

    <div class="post-body post-body-page prose prose-zinc max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
