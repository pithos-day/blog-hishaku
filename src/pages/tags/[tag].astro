---
import PostRow from '@/components/PostRow.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, type TagInfo } from '@/lib/tags';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tagInfo: tag },
  }));
}

interface Props {
  tagInfo: TagInfo;
}

const { tagInfo } = Astro.props;
const posts = await getPostsByTag(tagInfo.slug);
---

<BaseLayout
  title={t('tag.detailTitle', { name: tagInfo.name })}
  description={t('tag.listDescription', { name: tagInfo.name, count: posts.length })}
>
  <header class="page-header">
    <nav aria-label={t('common.breadcrumb')} class="page-breadcrumb">
      <a href="/tags/">{t('tag.title')}</a>
      <span class="mx-1">›</span>
      <span>{tagInfo.name}</span>
    </nav>
    <h1>{tagInfo.name}</h1>
    <p>{t('common.postCount', { count: posts.length })}</p>
  </header>
  <div class="mt-6">
    {posts.map((post) => <PostRow post={post} />)}
  </div>
</BaseLayout>
