---
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildTagHref, getAllTags } from '@/lib/tags';

const tags = await getAllTags();
---

<BaseLayout title={t('tag.title')}>
  <header class="page-header">
    <h1>{t('tag.title')}</h1>
    <p>{t('tag.total', { count: tags.length })}</p>
  </header>
  <div class="mt-6">
    {
      tags.length === 0 ? (
        <p class="text-fg-muted">{t('tag.empty')}</p>
      ) : (
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded border border-border px-2 py-1 text-sm">
              <a href={buildTagHref(tag.name)} class="hover:text-accent">
                {tag.name}
              </a>
              <span class="ml-1 text-fg-muted">{tag.count}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
