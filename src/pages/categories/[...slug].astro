---
import PostRow from '@/components/PostRow.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildCategoryHref, type CategoryNode, getCategoryTree } from '@/lib/categories';

export async function getStaticPaths() {
  const { byPath } = await getCategoryTree();
  return [...byPath.values()].map((node) => ({
    params: { slug: node.slugPath },
    props: { node },
  }));
}

interface Props {
  node: CategoryNode;
}

const { node } = Astro.props;
const breadcrumbs = node.names.map((_, index) => {
  const names = node.names.slice(0, index + 1);
  return { names, href: buildCategoryHref(names), name: names[names.length - 1] };
});
---

<BaseLayout
  title={node.names.join(' / ')}
  description={t('category.listDescription', { name: node.name, count: node.posts.length })}
>
  <header class="page-header">
    <nav aria-label={t('common.breadcrumb')} class="page-breadcrumb">
      <a href="/categories/">{t('category.title')}</a>
      {breadcrumbs.map((crumb) => (
        <>
          <span class="mx-1">›</span>
          <a href={crumb.href}>{crumb.name}</a>
        </>
      ))}
    </nav>
    <h1>{node.name}</h1>
    <p>{t('common.postCount', { count: node.posts.length })}</p>
  </header>

  {
    node.children.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {node.children.map((child) => (
          <li class="rounded border border-border px-2 py-1 text-sm">
            <a href={buildCategoryHref(child.names)} class="hover:text-accent">
              {child.name}
            </a>
            <span class="ml-1 text-fg-muted">({child.posts.length})</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-6">
    {node.posts.map((post) => <PostRow post={post} />)}
  </div>
</BaseLayout>
