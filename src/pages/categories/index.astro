---
import CategoryTree from '@/components/CategoryTree.astro';
import { t } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategoryTree } from '@/lib/categories';

const { roots } = await getCategoryTree();
---

<BaseLayout title={t('category.title')}>
  <header class="page-header">
    <h1>{t('category.title')}</h1>
  </header>
  <div class="mt-6">
    {
      roots.length === 0 ? (
        <p class="text-fg-muted">{t('category.empty')}</p>
      ) : (
        <CategoryTree nodes={roots} />
      )
    }
  </div>
</BaseLayout>
