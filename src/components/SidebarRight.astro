---
import { t } from '@/i18n';
import { getDayLink, getSidebarCalendar } from '@/lib/calendar';
import { siteConfig } from '@/lib/config';
import { postPath } from '@/lib/posts';
import type { SimilarPost } from '@/lib/similar-posts';

interface Props {
  similarPosts?: SimilarPost[];
}

const { similarPosts } = Astro.props;
const calendar = await getSidebarCalendar();

const socialEntries = Object.entries(siteConfig.social);
const profileName = siteConfig.site.name || siteConfig.site.title;

// 'calendar.weekdays' は「曜日名のカンマ区切り」形式 (ja.ts 側に注記あり)
const weekdays = t('calendar.weekdays').split(',');
---

<aside class="sidebar sidebar-right" aria-label={t('sidebar.rightPanel')}>
  <section id="profile" class="sidebar-module" aria-label={t('sidebar.profile')}>
    <h2 class="module-header">{t('sidebar.profile')}</h2>
    <div class="module-body profile-body">
      {
        siteConfig.site.avatar && (
          <img
            src={siteConfig.site.avatar}
            alt=""
            width="72"
            height="72"
            class="profile-avatar"
          />
        )
      }
      <p class="profile-name">{profileName}</p>
      {
        socialEntries.length > 0 && (
          <ul class="profile-social">
            {socialEntries.map(([name, social]) => (
              <li>
                <a
                  href={social.url}
                  rel="noopener noreferrer"
                  aria-label={name}
                  title={name}
                  style={social.color ? `color: ${social.color}` : undefined}
                >
                  {social.icon ? <iconify-icon icon={social.icon} aria-hidden="true" /> : name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="profile-about">
        <a href="/about/">{t('about.title')}</a>
      </p>
    </div>
  </section>

  <section id="calendar" class="sidebar-module" aria-label={t('sidebar.calendar')}>
    <div class="module-body calendar-body">
      <table class="calendar">
        <caption class="module-header">
          <a href="/archives/">{t('common.yearMonth', { year: calendar.year, month: calendar.month })}</a>
        </caption>
        <thead>
          <tr>
            {weekdays.map((day) => <th scope="col">{day}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            calendar.weeks.map((week) => (
              <tr>
                {week.map((cell) => {
                  if (!cell) return <td class="calendar-blank" />;
                  const href = getDayLink(cell);
                  return (
                    <td class={href ? 'calendar-post' : undefined}>
                      {href ? (
                        <a href={href} title={t('calendar.dayPosts', { count: cell.posts.length })}>
                          {cell.day}
                        </a>
                      ) : (
                        cell.day
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {
    similarPosts && similarPosts.length > 0 && (
      <section id="similar-posts" class="sidebar-module" aria-label={t('sidebar.similarPosts')}>
        <h2 class="module-header">{t('sidebar.similarPosts')}</h2>
        <div class="module-body">
          <ul class="similar-posts-list">
            {similarPosts.map((post) => (
              <li>
                <a href={postPath(post.slug)}>{post.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section id="search-module" class="sidebar-module" aria-label={t('common.search')}>
    <h2 class="module-header">{t('common.search')}</h2>
    <div class="module-body">
      <form id="sidebar-search" role="search" class="sidebar-search">
        <input
          type="search"
          name="q"
          placeholder={t('search.sidebarPlaceholder')}
          autocomplete="off"
          aria-label={t('search.label')}
        />
        <button type="submit">{t('common.search')}</button>
      </form>
    </div>
  </section>
</aside>
