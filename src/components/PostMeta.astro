---
import { t } from '@/i18n';
import { siteConfig } from '@/lib/config';
import { formatDate } from '@/lib/date';
import type { PostEntry } from '@/lib/posts';
import { formatCharacterCount, formatReadingTime, getTextStats } from '@/lib/reading';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const timezone = siteConfig.site.timezone;
const stats = getTextStats(post);
---

<span class="meta-item">
  <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
  <time datetime={post.data.date.toISOString()}>
    {formatDate(post.data.date, timezone)}
  </time>
</span>
{
  post.data.updated && (
    <span class="meta-item">
      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
      {t('post.updated', { date: formatDate(post.data.updated, timezone) })}
    </span>
  )
}
<span class="meta-item">
  <i class="fa-solid fa-pen-nib" aria-hidden="true"></i>
  {formatCharacterCount(stats.characters)}
</span>
<span class="meta-item">
  <i class="fa-solid fa-clock" aria-hidden="true"></i>
  {formatReadingTime(stats.minutes)}
</span>
