---
import { t } from '@/i18n';
import { getArchives } from '@/lib/archives';
import { buildCategoryHref, getCategoryTree } from '@/lib/categories';
import { getPostSlug, getPublishedPosts } from '@/lib/posts';
import { buildTagHref, getAllTags } from '@/lib/tags';

const RECENT_LIMIT = 10;
const BACKNUMBER_LIMIT = 10;

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, RECENT_LIMIT);

const archiveYears = await getArchives();
const backnumbers = archiveYears
  .flatMap((year) =>
    year.months.map((month) => ({
      label: t('common.yearMonth', { year: year.year, month: month.month }),
      href: `/archives#month-${month.year}-${String(month.month).padStart(2, '0')}`,
    })),
  )
  .slice(0, BACKNUMBER_LIMIT);

const { roots: categoryRoots } = await getCategoryTree();
const tags = await getAllTags();
---

<aside class="sidebar sidebar-left" aria-label={t('sidebar.leftPanel')}>
  <section id="recent-entries" class="sidebar-module" aria-label={t('sidebar.recent')}>
    <h2 class="module-header">{t('sidebar.recent')}</h2>
    <div class="module-body">
      {
        recentPosts.length > 0 ? (
          <ul class="module-list">
            {recentPosts.map((post) => (
              <li>
                <a href={`/post/${getPostSlug(post)}`} title={post.data.title}>
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">{t('common.noPosts')}</p>
        )
      }
    </div>
  </section>

  <section id="archive-datebased" class="sidebar-module" aria-label={t('sidebar.backnumber')}>
    <h2 class="module-header">{t('sidebar.backnumber')}</h2>
    <div class="module-body">
      {
        backnumbers.length > 0 ? (
          <ul class="module-list">
            {backnumbers.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">{t('common.noPosts')}</p>
        )
      }
    </div>
  </section>

  <section id="archive-category" class="sidebar-module" aria-label={t('sidebar.categoriesAria')}>
    <h2 class="module-header">{t('sidebar.categories')}</h2>
    <div class="module-body">
      {
        categoryRoots.length > 0 ? (
          <ul class="module-list">
            {categoryRoots.map((node) => (
              <li>
                <a href={buildCategoryHref(node.names)}>{node.name}</a>
                <span class="module-count">({node.posts.length})</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">{t('common.noCategories')}</p>
        )
      }
    </div>
  </section>

  <section id="tag-list" class="sidebar-module" aria-label={t('sidebar.tagsAria')}>
    <h2 class="module-header">{t('sidebar.tags')}</h2>
    <div class="module-body">
      {
        tags.length > 0 ? (
          <ul class="module-list module-list-inline">
            {tags.map((tag) => (
              <li>
                <a href={buildTagHref(tag.name)}>{tag.name}</a>
                <span class="module-count">({tag.count})</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">{t('common.noTags')}</p>
        )
      }
    </div>
  </section>
</aside>
