---
import { getArchives } from '@/lib/archives';
import { getDayLink, getSidebarCalendar } from '@/lib/calendar';
import { buildCategoryHref, getCategoryTree } from '@/lib/categories';
import { siteConfig } from '@/lib/config';
import { getPostSlug, getPublishedPosts } from '@/lib/posts';

const RECENT_LIMIT = 10;
const BACKNUMBER_LIMIT = 10;

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, RECENT_LIMIT);

const archiveYears = await getArchives();
const backnumbers = archiveYears
  .flatMap((year) =>
    year.months.map((month) => ({
      label: `${year.year}年${month.month}月`,
      href: `/archives#month-${month.year}-${String(month.month).padStart(2, '0')}`,
    })),
  )
  .slice(0, BACKNUMBER_LIMIT);

const calendar = await getSidebarCalendar();
const { roots: categoryRoots } = await getCategoryTree();

const aboutEntry = siteConfig.navigation.find((item) => item.path === '/about');
const menuItems = siteConfig.navigation.filter((item) => item.path !== '/about');

const weekdays = ['日', '月', '火', '水', '木', '金', '土'] as const;
---

<aside class="sidebar" aria-label="サイドパネル">
  <section id="search-module" class="sidebar-module" aria-label="検索">
    <h2 class="module-header">検索</h2>
    <div class="module-body">
      <form id="sidebar-search" role="search" class="sidebar-search">
        <input
          type="search"
          name="q"
          placeholder="キーワードを入力"
          autocomplete="off"
          aria-label="サイト内検索"
        />
        <button type="submit">検索</button>
      </form>
    </div>
  </section>

  <section id="menu" class="sidebar-module" aria-label="メニュー">
    <h2 class="module-header">メニュー</h2>
    <div class="module-body">
      <ul class="module-list">
        {
          menuItems.map((item) =>
            item.children && item.children.length > 0 ? (
              <li>
                <span class="menu-label">{item.name}</span>
                <ul class="menu-children">
                  {item.children
                    .filter((child) => child.path)
                    .map((child) => (
                      <li>
                        <a href={child.path}>{child.name}</a>
                      </li>
                    ))}
                </ul>
              </li>
            ) : item.path ? (
              <li>
                <a href={item.path}>{item.name}</a>
              </li>
            ) : (
              <li>
                <span class="menu-label">{item.name}</span>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </section>

  <section id="recent-entries" class="sidebar-module" aria-label="最近の記事">
    <h2 class="module-header">最近の記事</h2>
    <div class="module-body">
      {
        recentPosts.length > 0 ? (
          <ul class="module-list">
            {recentPosts.map((post) => (
              <li>
                <a href={`/post/${getPostSlug(post)}`} title={post.data.title}>
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">まだ記事がありません。</p>
        )
      }
    </div>
  </section>

  <section id="archive-datebased" class="sidebar-module" aria-label="バックナンバー">
    <h2 class="module-header">バックナンバー</h2>
    <div class="module-body">
      {
        backnumbers.length > 0 ? (
          <ul class="module-list">
            {backnumbers.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">まだ記事がありません。</p>
        )
      }
    </div>
  </section>

  <section id="calendar" class="sidebar-module" aria-label="カレンダー">
    <div class="module-body calendar-body">
      <table class="calendar">
        <caption class="module-header">
          <a href="/archives">{calendar.year}年{calendar.month}月</a>
        </caption>
        <thead>
          <tr>
            {weekdays.map((day) => <th scope="col">{day}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            calendar.weeks.map((week) => (
              <tr>
                {week.map((cell) => {
                  const href = getDayLink(cell);
                  if (!cell) return <td class="calendar-blank" />;
                  return (
                    <td class={href ? 'calendar-post' : undefined}>
                      {href ? (
                        <a href={href} title={`${cell.posts.length} 件の記事`}>
                          {cell.day}
                        </a>
                      ) : (
                        cell.day
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="archive-category" class="sidebar-module" aria-label="カテゴリー一覧">
    <h2 class="module-header">カテゴリー</h2>
    <div class="module-body">
      {
        categoryRoots.length > 0 ? (
          <ul class="module-list">
            {categoryRoots.map((node) => (
              <li>
                <a href={buildCategoryHref(node.names)}>{node.name}</a>
                <span class="module-count">({node.posts.length})</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="module-empty">まだカテゴリがありません。</p>
        )
      }
    </div>
  </section>

  {
    aboutEntry && (
      <section id="profile" class="sidebar-module" aria-label={aboutEntry.name}>
        <h2 class="module-header">{aboutEntry.name}</h2>
        <div class="module-body">
          <p class="link-note">
            <a href={aboutEntry.path}>{siteConfig.site.description ?? aboutEntry.name}</a>
          </p>
        </div>
      </section>
    )
  }
</aside>
