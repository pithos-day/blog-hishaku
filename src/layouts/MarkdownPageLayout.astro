---
import type { MarkdownHeading } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { collectTocHeadings } from '@/lib/toc';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  headings: MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props;
const tocHeadings = collectTocHeadings(headings);
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  type="article"
  tocHeadings={tocHeadings}
>
  <article data-pagefind-body>
    <header>
      <h1 class="entry-title-bar post-title">{frontmatter.title}</h1>
    </header>

    <div class="post-body post-body-page prose prose-zinc max-w-none dark:prose-invert">
      <slot />
    </div>
  </article>
</BaseLayout>
