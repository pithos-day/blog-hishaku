---
import SidebarLeft from '@/components/SidebarLeft.astro';
import SidebarRight from '@/components/SidebarRight.astro';
import { defaultLocale, t } from '@/i18n';
import { siteConfig } from '@/lib/config';
import type { TocHeading } from '@/lib/toc';
import '@/styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** 数式 (KaTeX) を含む記事か。非記事ページは false (既定) */
  math?: boolean;
  /** 目次パネルに表示する見出し (記事ページのみ渡す) */
  tocHeadings?: TocHeading[];
  /** canonical / og:url に使うパス (既定: 現在の URL) */
  canonicalPath?: string;
}

const {
  title,
  description = siteConfig.site.description ?? '',
  ogImage = siteConfig.site.defaultOgImage ?? siteConfig.site.avatar,
  type = 'website',
  math = false,
  tocHeadings,
  canonicalPath,
} = Astro.props;

const hasMath = siteConfig.content.enableMath && math !== false;

const pageTitle = title ? `${title} | ${siteConfig.site.title}` : siteConfig.site.title;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteConfig.site.url);
const year = new Date().getFullYear();
const startYear = siteConfig.site.startYear;
const copyright = startYear && startYear < year ? `${startYear}–${year}` : String(year);
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // テーマ初期化 (FOUC 防止)。優先順位: localStorage の明示指定 > システム設定
      (function () {
        var storageKey = 'theme';
        function getTheme() {
          try {
            var stored = window.localStorage.getItem(storageKey);
            if (stored === 'dark' || stored === 'light') return stored;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function applyTheme(theme) {
          var root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
        }
        applyTheme(getTheme());
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            // ユーザーが明示的に選択していない場合のみシステム設定に追従
            try {
              if (!window.localStorage.getItem(storageKey)) applyTheme(getTheme());
            } catch (e) {
              applyTheme(getTheme());
            }
          });
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {siteConfig.site.author && <meta name="author" content={siteConfig.site.author} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.site.avatar ?? '/favicon.svg'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.site.title}
      href={new URL('rss.xml', siteConfig.site.url)}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteConfig.site.url)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {hasMath && <link rel="stylesheet" href="/katex/katex.min.css" />}
    <script src="https://code.iconify.design/iconify-icon/3.0.3/iconify-icon.min.js" defer></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="site-container flex flex-1 flex-col">
      <header class="site-banner">
        <div class="banner-text">
          <h1><a href="/">{siteConfig.site.title}</a></h1>
          {siteConfig.site.subtitle && <p class="banner-subtitle">{siteConfig.site.subtitle}</p>}
        </div>
      </header>

      <div class="site-layout flex-1">
        <SidebarLeft tocHeadings={tocHeadings} />
        <main class="site-content">
          <slot />
        </main>
        <SidebarRight />
      </div>

      <footer>
        <div class="flex flex-col items-center gap-2 px-4 py-6 text-sm text-fg-muted">
          <p>
            © {copyright} {siteConfig.site.author}
          </p>
        </div>
      </footer>
    </div>

    <dialog
      id="search-dialog"
      aria-label={t('search.label')}
      class="m-auto w-[min(92vw,36rem)] rounded-lg border border-border bg-surface p-4 shadow-xl [&::backdrop]:bg-black/50"
    >
      <div class="mb-3 flex items-center gap-2">
        <input
          id="search-input"
          type="search"
          placeholder={t('search.placeholder')}
          autocomplete="off"
          class="w-full rounded border border-border bg-bg px-3 py-2 outline-none focus:border-accent"
        />
        <button type="button" id="search-close" class="shrink-0 text-sm text-fg-muted hover:text-accent">
          {t('common.close')}
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] space-y-2 overflow-y-auto"></div>
    </dialog>

    <div id="floating-group" class="floating-group" data-expanded="false">
      <div id="floating-actions" class="floating-actions">
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle floating-btn"
          aria-label={t('common.themeToggle')}
          title={t('common.themeToggle')}
        >
          <i data-lucide="sun" class="theme-icon theme-icon-sun" aria-hidden="true"></i>
          <i data-lucide="moon" class="theme-icon theme-icon-moon" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="floating-top"
          class="floating-btn"
          aria-label={t('floating.backToTop')}
          title={t('floating.backToTop')}
        >
          <i data-lucide="arrow-up" class="fi" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="floating-bottom"
          class="floating-btn"
          aria-label={t('floating.scrollToBottom')}
          title={t('floating.scrollToBottom')}
        >
          <i data-lucide="arrow-down" class="fi" aria-hidden="true"></i>
        </button>
      </div>
      <button
        type="button"
        id="floating-toggle"
        class="floating-btn floating-toggle"
        aria-label={t('floating.toggleToolbar')}
        title={t('floating.toggleToolbar')}
        aria-expanded="false"
        aria-controls="floating-actions"
      >
        <i data-lucide="sparkles" class="fi fi-collapsed" aria-hidden="true"></i>
        <i data-lucide="x" class="fi fi-expanded" aria-hidden="true"></i>
      </button>
    </div>

    <script>
      import { ArrowDown, ArrowUp, createIcons, Moon, Sparkles, Sun, X } from 'lucide';
      import { t } from '@/i18n';

      interface PagefindSearchResult {
        data(): Promise<{ url: string; meta: { title?: string }; excerpt: string }>;
      }
      interface PagefindApi {
        init(): Promise<void>;
        search(query: string): Promise<{ results: PagefindSearchResult[] }>;
      }

      const dialog = document.getElementById('search-dialog');
      const closeButton = document.getElementById('search-close');
      const input = document.getElementById('search-input');
      const resultsBox = document.getElementById('search-results');

      if (dialog instanceof HTMLDialogElement && closeButton && input instanceof HTMLInputElement && resultsBox) {
        let pagefindPromise: Promise<PagefindApi | null> | undefined;

        const loadPagefind = (): Promise<PagefindApi | null> => {
          if (!pagefindPromise) {
            const baseUrl = import.meta.env.BASE_URL;
            pagefindPromise = import(/* @vite-ignore */ `${baseUrl}pagefind/pagefind.js`)
              .then(async (module) => {
                const pagefind = module as unknown as PagefindApi;
                await pagefind.init();
                return pagefind;
              })
              .catch(() => null);
          }
          return pagefindPromise;
        };

        const runSearch = async (): Promise<void> => {
          const query = input.value.trim();
          resultsBox.replaceChildren();
          if (!query) return;
          const pagefind = await loadPagefind();
          if (!pagefind) {
            resultsBox.textContent = t('search.noIndex');
            return;
          }
          const found = await pagefind.search(query);
          const entries = await Promise.all(found.results.slice(0, 10).map((result) => result.data()));
          if (entries.length === 0) {
            resultsBox.textContent = t('search.noResults');
            return;
          }
          for (const entry of entries) {
            const link = document.createElement('a');
            link.href = entry.url;
            link.className = 'block rounded border border-border px-3 py-2 hover:border-accent';
            const title = document.createElement('div');
            title.className = 'font-medium';
            title.textContent = entry.meta.title ?? entry.url;
            const excerpt = document.createElement('div');
            excerpt.className = 'text-sm text-fg-muted';
            excerpt.innerHTML = entry.excerpt;
            link.append(title, excerpt);
            resultsBox.append(link);
          }
        };

        const openDialog = (): void => {
          if (!dialog.open) dialog.showModal();
          void loadPagefind();
          input.focus();
        };

        let searchTimer: ReturnType<typeof setTimeout> | undefined;
        closeButton.addEventListener('click', () => dialog.close());
        // バックドロップ (ウインドウ外側) をクリックしたら閉じる
        dialog.addEventListener('click', (event) => {
          const rect = dialog.getBoundingClientRect();
          const inside =
            event.clientX >= rect.left &&
            event.clientX <= rect.right &&
            event.clientY >= rect.top &&
            event.clientY <= rect.bottom;
          if (!inside) dialog.close();
        });
        input.addEventListener('input', () => {
          if (searchTimer) clearTimeout(searchTimer);
          searchTimer = setTimeout(() => void runSearch(), 150);
        });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            void runSearch();
          }
        });

        const sidebarForm = document.getElementById('sidebar-search');
        sidebarForm?.addEventListener('submit', (event) => {
          event.preventDefault();
          const sidebarInput = sidebarForm.querySelector('input[name="q"]');
          input.value = sidebarInput instanceof HTMLInputElement ? sidebarInput.value : '';
          openDialog();
          void runSearch();
        });
      }

      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.classList.contains('dark') ? 'light' : 'dark';
        root.classList.add('theme-transition');
        root.classList.toggle('dark', next === 'dark');
        root.dataset.theme = next;
        try {
          window.localStorage.setItem('theme', next);
        } catch {
          // localStorage が使えない環境ではセッション内のみ反映
        }
        setTimeout(() => root.classList.remove('theme-transition'), 400);
      });

      // フローティングツールバー (右下): 展開切替とページ内スクロール
      const floatingGroup = document.getElementById('floating-group');
      const floatingToggle = document.getElementById('floating-toggle');
      if (floatingGroup && floatingToggle) {
        floatingToggle.addEventListener('click', () => {
          const expanded = floatingGroup.dataset.expanded !== 'true';
          floatingGroup.dataset.expanded = String(expanded);
          floatingToggle.setAttribute('aria-expanded', String(expanded));
        });
        const scrollBehavior = (): ScrollBehavior =>
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        document.getElementById('floating-top')?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: scrollBehavior() });
        });
        document.getElementById('floating-bottom')?.addEventListener('click', () => {
          window.scrollTo({ top: document.documentElement.scrollHeight, behavior: scrollBehavior() });
        });
      }

      // Lucide アイコンの置換 (テーマトグルの太陽 / 月、フローティングツールバー)
      createIcons({ icons: { Sun, Moon, Sparkles, X, ArrowUp, ArrowDown } });
    </script>
  </body>
</html>
