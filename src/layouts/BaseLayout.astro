---
import { Icon } from 'astro-icon/components';
import { SEO, type TwitterCardType } from 'astro-seo';
import SidebarLeft from '@/components/SidebarLeft.astro';
import SidebarRight from '@/components/SidebarRight.astro';
import UmamiAnalytics from '@/components/UmamiAnalytics.astro';
import { defaultLocale, t } from '@/i18n';
import { siteConfig } from '@/lib/config';
import { mergeSiteKeywords } from '@/lib/seo';
import type { SimilarPost } from '@/lib/similar-posts';
import type { TocHeading } from '@/lib/toc';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 記事 frontmatter のキーワード (サイト keywords と合わせて meta keywords に出力) */
  keywords?: string[];
  ogImage?: string;
  type?: 'website' | 'article';
  /** 数式 (KaTeX) を含む記事か。非記事ページは false (既定) */
  math?: boolean;
  /** 目次パネルに表示する見出し (記事ページのみ渡す) */
  tocHeadings?: TocHeading[];
  /** 右サイドパネルに表示する類似記事 (記事ページのみ渡す) */
  similarPosts?: SimilarPost[];
  /** canonical / og:url に使うパス (既定: 現在の URL) */
  canonicalPath?: string;
  /** og:title の上書き (既定: ページタイトル) */
  ogTitle?: string;
  /** og:description の上書き (既定: description) */
  ogDescription?: string;
  /** ページ単位の robots ディレクティブ (例: noindex, nofollow) — robots.txt の policy 設定とは別物 */
  robotsMeta?: string;
}

const {
  title,
  description = siteConfig.site.description ?? '',
  keywords,
  ogImage = siteConfig.site.defaultOgImage ?? siteConfig.site.avatar,
  type = 'website',
  math = false,
  tocHeadings,
  similarPosts,
  canonicalPath,
  ogTitle,
  ogDescription,
  robotsMeta,
} = Astro.props;

const hasMath = siteConfig.content.enableMath && math !== false;

const pageTitle = title ? `${title} | ${siteConfig.site.title}` : siteConfig.site.title;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteConfig.site.url);
const year = new Date().getFullYear();
const startYear = siteConfig.site.startYear;
const copyright = startYear && startYear < year ? `${startYear}–${year}` : String(year);
// meta keywords: 記事キーワードにサイトキーワードを続けて重複除去する
const metaKeywords = mergeSiteKeywords(keywords ?? [], siteConfig.site.keywords);
// OGP: 指定がなければ <title> / description と同じ値を使う
const resolvedOgTitle = ogTitle ?? pageTitle;
const resolvedOgDescription = ogDescription ?? description;
const ogImageUrl = ogImage ? new URL(ogImage, siteConfig.site.url) : undefined;
// Twitter カード: 画像があれば大画像、なければサマリー
const twitterCard: TwitterCardType = ogImageUrl ? 'summary_large_image' : 'summary';
// フッターのコピーライト表記: name@alternate (alternate がなければ name)
const siteName = siteConfig.site.name || siteConfig.site.title;
const copyrightHolder = siteConfig.site.alternate
  ? `${siteName}@${siteConfig.site.alternate}`
  : siteName;

// <SEO> へ渡す構造体 (テンプレートを平らに保つため frontmatter で組み立てる)
const seoOpenGraph = {
  basic: {
    title: resolvedOgTitle,
    type,
    image: ogImageUrl?.href ?? '',
    url: canonicalUrl.href,
  },
  optional: {
    siteName,
    description: resolvedOgDescription,
  },
};

const seoTwitter = {
  card: twitterCard,
  title: resolvedOgTitle,
  description: resolvedOgDescription,
  ...(ogImageUrl && { image: ogImageUrl.href }),
};

const seoExtend = {
  meta: [
    ...(metaKeywords.length > 0 ? [{ name: 'keywords', content: metaKeywords.join(', ') }] : []),
    ...(siteConfig.site.author ? [{ name: 'author', content: siteConfig.site.author }] : []),
    ...(robotsMeta ? [{ name: 'robots', content: robotsMeta }] : []),
  ],
  link: [
    { rel: 'icon', type: 'image/svg+xml', href: siteConfig.site.avatar ?? '/favicon.svg' },
    {
      rel: 'alternate',
      type: 'application/rss+xml',
      title: siteConfig.site.title,
      href: new URL('rss.xml', siteConfig.site.url).href,
    },
  ],
};
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <!-- 外部メディア (video.twimg.com 等) のホットリンク保護で Referer 付きだと 403 になるため、サイト全体で Referer を送らない -->
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // テーマ初期化 (FOUC 防止)。優先順位: localStorage の明示指定 > システム設定
      (function () {
        var storageKey = 'theme';
        function getTheme() {
          try {
            var stored = window.localStorage.getItem(storageKey);
            if (stored === 'dark' || stored === 'light') return stored;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function applyTheme(theme) {
          var root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
        }
        applyTheme(getTheme());
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            // ユーザーが明示的に選択していない場合のみシステム設定に追従
            try {
              if (!window.localStorage.getItem(storageKey)) applyTheme(getTheme());
            } catch (e) {
              applyTheme(getTheme());
            }
          });
        } catch (e) {}
      })();
    </script>
    <script>
      // iconify-icon はカスタム要素登録が目的の副作用 import。
      // frontmatter ではビルド時 (Node) 側にしか評価されないため script で読み込む。
      import 'iconify-icon';
    </script>
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalUrl.href}
      openGraph={seoOpenGraph}
      twitter={seoTwitter}
      extend={seoExtend}
    />
    {hasMath && <link rel="stylesheet" href="/katex/katex.min.css" />}
    <UmamiAnalytics />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="site-container flex flex-1 flex-col">
      <header class="site-banner">
        <div class="banner-text">
          <h1><a href="/">{siteConfig.site.title}</a></h1>
          {siteConfig.site.subtitle && <p class="banner-subtitle">{siteConfig.site.subtitle}</p>}
        </div>
      </header>

      <div class="site-layout flex-1">
        <SidebarLeft tocHeadings={tocHeadings} />
        <main class="site-content">
          <slot />
        </main>
        <SidebarRight similarPosts={similarPosts} />
      </div>

      <footer>
        <div class="flex flex-col items-center gap-2 px-4 py-6 text-sm text-fg-muted">
          <p>
            © {copyright} {copyrightHolder}
          </p>
        </div>
      </footer>
    </div>

    <dialog
      id="search-dialog"
      aria-label={t('search.label')}
      class="m-auto w-[min(92vw,36rem)] rounded-lg border border-border bg-surface p-4 shadow-xl [&::backdrop]:bg-black/50"
    >
      <div class="mb-3 flex items-center gap-2">
        <input
          id="search-input"
          type="search"
          placeholder={t('search.placeholder')}
          autocomplete="off"
          class="w-full rounded border border-border bg-bg px-3 py-2 outline-none focus:border-accent"
        />
        <button type="button" id="search-close" class="shrink-0 text-sm text-fg-muted hover:text-accent">
          {t('common.close')}
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] space-y-2 overflow-y-auto"></div>
    </dialog>

    <dialog
      id="lightbox-dialog"
      class="lightbox-dialog m-auto border-0 bg-transparent p-0 shadow-none [&::backdrop]:bg-black/80"
      aria-label={t('common.lightboxAria')}
    >
      <img id="lightbox-img" src="" alt="" class="lightbox-img" />
      <button
        type="button"
        id="lightbox-close"
        class="lightbox-close"
        aria-label={t('common.close')}
        title={t('common.close')}
      >
        <Icon name="lucide:x" aria-hidden="true" />
      </button>
    </dialog>

    <div id="floating-group" class="floating-group" data-expanded="false">
      <div id="floating-actions" class="floating-actions">
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle floating-btn"
          aria-label={t('common.themeToggle')}
          title={t('common.themeToggle')}
        >
          <Icon name="lucide:sun" class="theme-icon theme-icon-sun" aria-hidden="true" />
          <Icon name="lucide:moon" class="theme-icon theme-icon-moon" aria-hidden="true" />
        </button>
        <button
          type="button"
          id="floating-top"
          class="floating-btn"
          aria-label={t('floating.backToTop')}
          title={t('floating.backToTop')}
        >
          <Icon name="lucide:arrow-up" class="fi" aria-hidden="true" />
        </button>
        <button
          type="button"
          id="floating-bottom"
          class="floating-btn"
          aria-label={t('floating.scrollToBottom')}
          title={t('floating.scrollToBottom')}
        >
          <Icon name="lucide:arrow-down" class="fi" aria-hidden="true" />
        </button>
      </div>
      <button
        type="button"
        id="floating-toggle"
        class="floating-btn floating-toggle"
        aria-label={t('floating.toggleToolbar')}
        title={t('floating.toggleToolbar')}
        aria-expanded="false"
        aria-controls="floating-actions"
      >
        <Icon name="lucide:sparkles" class="fi fi-collapsed" aria-hidden="true" />
        <Icon name="lucide:x" class="fi fi-expanded" aria-hidden="true" />
      </button>
    </div>

    <script>
      import { initEmbeds } from '@/scripts/embed';
      import { initFloatingActions } from '@/scripts/floating';
      import { initLightbox } from '@/scripts/lightbox';
      import { initSearch } from '@/scripts/search';
      import { initThemeToggle } from '@/scripts/theme';

      initSearch();
      initThemeToggle();
      initFloatingActions();
      initEmbeds();
      initLightbox();
    </script>
  </body>
</html>
