---
import SidebarLeft from '@/components/SidebarLeft.astro';
import SidebarRight from '@/components/SidebarRight.astro';
import UmamiAnalytics from '@/components/UmamiAnalytics.astro';
import { defaultLocale, t } from '@/i18n';
import { siteConfig } from '@/lib/config';
import type { TocHeading } from '@/lib/toc';
import '@/styles/global.css';
import '@fortawesome/fontawesome-free/css/all.min.css';

interface Props {
  title?: string;
  description?: string;
  /** 記事 frontmatter のキーワード (サイト keywords と合わせて meta keywords に出力) */
  keywords?: string[];
  ogImage?: string;
  type?: 'website' | 'article';
  /** 数式 (KaTeX) を含む記事か。非記事ページは false (既定) */
  math?: boolean;
  /** 目次パネルに表示する見出し (記事ページのみ渡す) */
  tocHeadings?: TocHeading[];
  /** canonical / og:url に使うパス (既定: 現在の URL) */
  canonicalPath?: string;
  /** og:title の上書き (既定: ページタイトル) */
  ogTitle?: string;
  /** og:description の上書き (既定: description) */
  ogDescription?: string;
  /** ページ単位の robots ディレクティブ (例: noindex, nofollow) */
  robots?: string;
}

const {
  title,
  description = siteConfig.site.description ?? '',
  keywords,
  ogImage = siteConfig.site.defaultOgImage ?? siteConfig.site.avatar,
  type = 'website',
  math = false,
  tocHeadings,
  canonicalPath,
  ogTitle,
  ogDescription,
  robots,
} = Astro.props;

const hasMath = siteConfig.content.enableMath && math !== false;

const pageTitle = title ? `${title} | ${siteConfig.site.title}` : siteConfig.site.title;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteConfig.site.url);
const year = new Date().getFullYear();
const startYear = siteConfig.site.startYear;
const copyright = startYear && startYear < year ? `${startYear}–${year}` : String(year);
// meta keywords: 記事キーワードにサイトキーワードを続けて重複除去する
const metaKeywords = [...new Set([...(keywords ?? []), ...siteConfig.site.keywords])];
// OGP: 指定がなければ <title> / description と同じ値を使う
const resolvedOgTitle = ogTitle ?? pageTitle;
const resolvedOgDescription = ogDescription ?? description;
const ogImageUrl = ogImage ? new URL(ogImage, siteConfig.site.url) : undefined;
// Twitter カード: 画像があれば大画像、なければサマリー
const twitterCard = ogImageUrl ? 'summary_large_image' : 'summary';
// フッターのコピーライト表記: name@alternate (alternate がなければ name)
const siteName = siteConfig.site.name || siteConfig.site.title;
const copyrightHolder = siteConfig.site.alternate
  ? `${siteName}@${siteConfig.site.alternate}`
  : siteName;
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // テーマ初期化 (FOUC 防止)。優先順位: localStorage の明示指定 > システム設定
      (function () {
        var storageKey = 'theme';
        function getTheme() {
          try {
            var stored = window.localStorage.getItem(storageKey);
            if (stored === 'dark' || stored === 'light') return stored;
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function applyTheme(theme) {
          var root = document.documentElement;
          root.classList.toggle('dark', theme === 'dark');
          root.dataset.theme = theme;
        }
        applyTheme(getTheme());
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            // ユーザーが明示的に選択していない場合のみシステム設定に追従
            try {
              if (!window.localStorage.getItem(storageKey)) applyTheme(getTheme());
            } catch (e) {
              applyTheme(getTheme());
            }
          });
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {metaKeywords.length > 0 && <meta name="keywords" content={metaKeywords.join(', ')} />}
    {siteConfig.site.author && <meta name="author" content={siteConfig.site.author} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={siteConfig.site.avatar ?? '/favicon.svg'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.site.title}
      href={new URL('rss.xml', siteConfig.site.url)}
    />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    {hasMath && <link rel="stylesheet" href="/katex/katex.min.css" />}
    <script src="https://code.iconify.design/iconify-icon/3.0.3/iconify-icon.min.js" defer></script>
    <UmamiAnalytics />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="site-container flex flex-1 flex-col">
      <header class="site-banner">
        <div class="banner-text">
          <h1><a href="/">{siteConfig.site.title}</a></h1>
          {siteConfig.site.subtitle && <p class="banner-subtitle">{siteConfig.site.subtitle}</p>}
        </div>
      </header>

      <div class="site-layout flex-1">
        <SidebarLeft tocHeadings={tocHeadings} />
        <main class="site-content">
          <slot />
        </main>
        <SidebarRight />
      </div>

      <footer>
        <div class="flex flex-col items-center gap-2 px-4 py-6 text-sm text-fg-muted">
          <p>
            © {copyright} {copyrightHolder}
          </p>
        </div>
      </footer>
    </div>

    <dialog
      id="search-dialog"
      aria-label={t('search.label')}
      class="m-auto w-[min(92vw,36rem)] rounded-lg border border-border bg-surface p-4 shadow-xl [&::backdrop]:bg-black/50"
    >
      <div class="mb-3 flex items-center gap-2">
        <input
          id="search-input"
          type="search"
          placeholder={t('search.placeholder')}
          autocomplete="off"
          class="w-full rounded border border-border bg-bg px-3 py-2 outline-none focus:border-accent"
        />
        <button type="button" id="search-close" class="shrink-0 text-sm text-fg-muted hover:text-accent">
          {t('common.close')}
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] space-y-2 overflow-y-auto"></div>
    </dialog>

    <div id="floating-group" class="floating-group" data-expanded="false">
      <div id="floating-actions" class="floating-actions">
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle floating-btn"
          aria-label={t('common.themeToggle')}
          title={t('common.themeToggle')}
        >
          <i data-lucide="sun" class="theme-icon theme-icon-sun" aria-hidden="true"></i>
          <i data-lucide="moon" class="theme-icon theme-icon-moon" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="floating-top"
          class="floating-btn"
          aria-label={t('floating.backToTop')}
          title={t('floating.backToTop')}
        >
          <i data-lucide="arrow-up" class="fi" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="floating-bottom"
          class="floating-btn"
          aria-label={t('floating.scrollToBottom')}
          title={t('floating.scrollToBottom')}
        >
          <i data-lucide="arrow-down" class="fi" aria-hidden="true"></i>
        </button>
      </div>
      <button
        type="button"
        id="floating-toggle"
        class="floating-btn floating-toggle"
        aria-label={t('floating.toggleToolbar')}
        title={t('floating.toggleToolbar')}
        aria-expanded="false"
        aria-controls="floating-actions"
      >
        <i data-lucide="sparkles" class="fi fi-collapsed" aria-hidden="true"></i>
        <i data-lucide="x" class="fi fi-expanded" aria-hidden="true"></i>
      </button>
    </div>

    <script>
    import { ArrowDown, ArrowUp, createIcons, Moon, Sparkles, Sun, X } from 'lucide';
    import { initEmbeds } from '@/scripts/embed';
    import { initFloatingActions } from '@/scripts/floating';
    import { initSearch } from '@/scripts/search';
    import { initThemeToggle } from '@/scripts/theme';

    initSearch();
    initThemeToggle();
    initFloatingActions();
    initEmbeds();

      // Lucide アイコンの置換 (テーマトグルの太陽 / 月、フローティングツールバー)
      createIcons({ icons: { Sun, Moon, Sparkles, X, ArrowUp, ArrowDown } });
    </script>
  </body>
</html>
