{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/pages/**/*.astro",
    "src/pages/**/*.ts",
    "src/layouts/**/*.astro",
    "src/scripts/**/*.ts",
    "src/lib/config/site.ts",
    "src/lib/markdown/*.ts",
    "src/i18n/index.ts",
    "scripts/**/*.{ts,mjs}",
    "test/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx,astro,css}", "scripts/**/*.{ts,mjs}", "test/**/*.mjs"],
  "ignoreDependencies": [
    "@iconify-json/fa7-solid",
    "@iconify-json/lucide",
    "@iconify-json/ri",
    "katex",
    "wrangler"
  ]
}
