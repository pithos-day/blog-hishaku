{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "astro.config.mjs",
    "src/content.config.ts",
    "src/pages/**/*.astro",
    "src/pages/**/*.ts",
    "src/layouts/**/*.astro",
    "src/scripts/**/*.ts",
    "src/lib/config/site.ts",
    "src/lib/markdown/*.ts",
    "src/i18n/index.ts",
    "scripts/**/*.mjs",
    "test/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx,astro}", "scripts/**/*.mjs", "test/**/*.mjs"],
  "ignore": ["src/assets/**", "src/content/**", "public/**", "dist/**", ".cache/**"],
  "ignoreDependencies": ["@biomejs/biome", "husky", "lint-staged", "pagefind", "typescript"]
}
