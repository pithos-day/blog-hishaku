{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "astro.config.mjs",
    "src/pages/**/*.astro",
    "src/pages/**/*.ts",
    "src/layouts/**/*.astro",
    "src/scripts/**/*.ts",
    "src/lib/config/site.ts",
    "src/lib/markdown/*.ts",
    "src/i18n/index.ts",
    "scripts/**/*.{ts,mjs}",
    "test/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx,astro}", "scripts/**/*.{ts,mjs}", "test/**/*.mjs"],
  "ignore": ["src/assets/**", "src/content/**", "public/**", "dist/**", ".cache/**"],
  "ignoreDependencies": [
    "@biomejs/biome",
    "@iconify-json/fa7-solid",
    "@iconify-json/lucide",
    "@iconify-json/ri",
    "@tailwindcss/typography",
    "husky",
    "katex",
    "lint-staged",
    "pagefind",
    "tailwindcss",
    "typescript"
  ]
}
